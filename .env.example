# Public
NEXT_PUBLIC_SITE_URL=https://pixelatebanana.com
# AdSense (leave empty to disable ads). Create 3 ad units in AdSense and paste each ID below.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FEED=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
# builtin = our consent banner. google = you turned on Google's certified Privacy & messaging in AdSense.
NEXT_PUBLIC_CONSENT_MODE=builtin
# Server-only secrets (never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=
INQUIRY_FROM=PixelateBanana <hello@yourdomain.com>
INQUIRY_TO=you@yourdomain.com
# Optional: also save every quote/chat message to Google Sheets (server-only; tabs named Quotes and Chat)
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
